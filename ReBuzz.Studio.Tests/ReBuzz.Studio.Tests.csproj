<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork (docs/specs/studio-mvp.md §3.7): the studio's views, rendered headless (Avalonia.Headless
    with Skia) on Linux CI: each test can take simulated input and save what it drew as a PNG.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ReBuzz.Studio.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- HeadlessInput.cs replaces the headless platform's settings (double clicks by the tests, not by the
         clock), which only Avalonia's AvaloniaLocator can: its private API, through Avalonia's own switch. The
         package is pinned (12.1.4), and its warning (AVA3001) is a message here. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVA3001</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Fork (docs/specs/daw-modes.md §8.1): methods with loops compiled fully optimised at once, so the audio
       thread never compiles an on-stack replacement (tools/msbuild/AudioThreadRuntime.props). -->
  <Import Project="..\tools\msbuild\AudioThreadRuntime.props" />

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.NUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReBuzz.Studio\ReBuzz.Studio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- The machine keyboard's tests hear the pitch a click plays with the analysis library's YIN (as the agent's analyze does). -->
  <ItemGroup>
    <Compile Include="..\Machines\NeoBuzz.Analysis\Yin.cs;..\Machines\NeoBuzz.Analysis\Fft.cs" Link="Analysis\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The audio hygiene tests describe a buffer that allocated as the engine's and the machines' tests do (AllocationWindow). -->
  <ItemGroup>
    <Compile Include="..\ReBuzzTests\Automation\GuardPolicy.cs" Link="Automation\GuardPolicy.cs" />
    <Compile Include="..\ReBuzzTests\Automation\AllocationWindow.cs" Link="Automation\AllocationWindow.cs" />
  </ItemGroup>

  <!-- The UI gallery's demo song (docs/specs/ui-gallery.md), shared with ReBuzz.exe (its ui-shots switch). -->
  <ItemGroup>
    <Compile Include="..\ReBuzz\AppViews\GallerySong.cs" Link="GallerySong.cs" />
  </ItemGroup>

  <!-- Fixtures the tests read beside them: Info's saved state (machine-safety.md §3.5). -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The engine the tests start finds its gear beside them, as the app does (Neo editors included). -->
  <PropertyGroup>
    <NeoGearFlavour>Studio</NeoGearFlavour>
  </PropertyGroup>
  <Import Project="..\ReBuzz.Host\AppGear.targets" />

  <!-- The guard's test machine (docs/specs/machine-safety.md §5), a project of its own, in the tests'
       Gear/Generators. Restored on its own first, so the build sees what it restored. -->
  <ItemGroup>
    <Compile Remove="TestMachines\**" />
    <None Remove="TestMachines\**" />
    <EmbeddedResource Remove="TestMachines\**" />
  </ItemGroup>
  <Target Name="GuardTestGear" AfterTargets="Build">
    <MSBuild Projects="TestMachines\GuardTest.csproj" Targets="Restore" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration);_GuardTestRestore=true" />
    <MSBuild Projects="TestMachines\GuardTest.csproj" Targets="Build" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration)" />
    <!-- The machine keyboard's synth that takes notes only in its Note track (TestMachines/KeysTest), the same way. -->
    <MSBuild Projects="TestMachines\KeysTest\KeysTest.csproj" Targets="Restore" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration);_KeysTestRestore=true" />
    <MSBuild Projects="TestMachines\KeysTest\KeysTest.csproj" Targets="Build" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration)" />
  </Target>

  <!-- Dye Essence's G0 stress machine (docs/specs/dye-essence.md §5.2): about 700 parameters and a large
       state, in the tests' Gear/Generators the same way. -->
  <Target Name="DyeStressGear" AfterTargets="Build">
    <MSBuild Projects="TestMachines\DyeStress\DyeStress.csproj" Targets="Restore" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration);_DyeStressRestore=true" />
    <MSBuild Projects="TestMachines\DyeStress\DyeStress.csproj" Targets="Build" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration)" />
  </Target>

</Project>
