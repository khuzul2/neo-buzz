<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fork (docs/specs/multi-output.md): the several-output proof machine (MultiOut.cs), built for net10.0 into the studio tests' Gear/Generators
    as "Multi Test.NET.dll", as GuardTest.csproj builds the guard's. It links NeoOutputs.cs, the SDK's output names, as a Neo machine does.
    The tests' project builds it; it is not shipped.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Multi Test.NET</AssemblyName>
    <RootNamespace>ReBuzz.Studio.Tests.TestMachines</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <M>$(MSBuildThisFileDirectory)..\..\..\Machines\</M>
    <GearDir Condition="'$(GearDir)' == ''">$(MSBuildThisFileDirectory)bin\Gear\</GearDir>
    <OutDir>$([MSBuild]::EnsureTrailingSlash('$(GearDir)'))Generators\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MultiOut.cs" />
    <Compile Include="$(M)NeoBuzz.Machine\NeoOutputs.cs" Link="Shared\Machine\NeoOutputs.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine's portable machine API; the host provides it at run time (not copied). -->
    <ProjectReference Include="..\..\..\ReBuzzGUI\BuzzGUI.Common\BuzzGUI.Common.csproj" Private="false" GlobalPropertiesToRemove="GearDir" />
    <ProjectReference Include="..\..\..\ReBuzzGUI\BuzzGUI.Interfaces\BuzzGUI.Interfaces.csproj" Private="false" GlobalPropertiesToRemove="GearDir" />
  </ItemGroup>
</Project>
