<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fork (docs/specs/instrument-input.md): a proof machine of audio into an instrument (InputTest.cs), built for net10.0 into the studio tests'
    Gear/Generators as "Input Test.NET.dll", as MultiOut.csproj builds the several-output one. The tests' project builds it; it is not shipped.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Input Test.NET</AssemblyName>
    <RootNamespace>ReBuzz.Studio.Tests.TestMachines</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GearDir Condition="'$(GearDir)' == ''">$(MSBuildThisFileDirectory)bin\Gear\</GearDir>
    <OutDir>$([MSBuild]::EnsureTrailingSlash('$(GearDir)'))Generators\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="InputTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine's portable machine API; the host provides it at run time (not copied). -->
    <ProjectReference Include="..\..\..\ReBuzzGUI\BuzzGUI.Common\BuzzGUI.Common.csproj" Private="false" GlobalPropertiesToRemove="GearDir" />
    <ProjectReference Include="..\..\..\ReBuzzGUI\BuzzGUI.Interfaces\BuzzGUI.Interfaces.csproj" Private="false" GlobalPropertiesToRemove="GearDir" />
  </ItemGroup>
</Project>
