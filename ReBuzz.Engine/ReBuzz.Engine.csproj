<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork (docs/specs/engine-split.md §5, cross-platform.md §5.2 P1): the engine as a plain net10.0
    assembly, with no WPF and no Windows targeting. It compiles the engine files of ReBuzz where
    they are (EngineFiles.props), against the portable builds of BuzzGUI.Interfaces and
    BuzzGUI.Common. ReBuzz.exe references it and leaves those files out; on Windows the app ships
    the Windows builds of the two libraries, which are supersets of the portable ones (§4.3).
    Linux CI builds it. ("ReBuzz.Engine" is this managed engine; ReBuzzEngine/ is the native host.)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ReBuzz.Engine</AssemblyName>
    <RootNamespace>ReBuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0067;CS8632;SYSLIB0011;SYSLIB0014;CA1416</NoWarn>
  </PropertyGroup>

  <Import Project="EngineFiles.props" />

  <ItemGroup>
    <Compile Include="@(EngineSource)" />
    <!-- The r8brain resampler interop (its own copy; BuzzGUI.WaveformControl compiles the same files). -->
    <Compile Include="..\ReBuzzGUI\BuzzGUI.WaveformControl\r8brain\*.cs" Link="r8brain\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReBuzz" />
    <InternalsVisibleTo Include="ReBuzzTests" />
    <InternalsVisibleTo Include="rebuzz-headless" />
  </ItemGroup>

  <!-- Build number and date (S10), read by Core/BuildInfo.cs. ReBuzz.exe's About box reads the
       same files from its resources. -->
  <ItemGroup>
    <EmbeddedResource Include="$(EngineRoot)BuildNumber.txt" LogicalName="ReBuzz.BuildNumber.txt" Link="BuildNumber.txt" />
    <EmbeddedResource Include="$(EngineRoot)BuildDate.txt" LogicalName="ReBuzz.BuildDate.txt" Link="BuildDate.txt" />
  </ItemGroup>
  <!-- The build date is stamped here (it was ReBuzz.csproj's pre-build step): the engine builds first. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PreBuildEvent>powershell -Command "((Get-Date).ToUniversalTime()).ToString('s') | Out-File '$(MSBuildProjectDirectory)\..\ReBuzz\BuildDate.txt'"</PreBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <!-- Portable builds (net10.0) of the machine API: engine-split.md §4. Not copied: the app
         ships the Windows builds, which machines bind to. -->
    <ProjectReference Include="..\ReBuzzGUI\BuzzGUI.Interfaces\BuzzGUI.Interfaces.csproj" Private="false" />
    <ProjectReference Include="..\ReBuzzGUI\BuzzGUI.Common\BuzzGUI.Common.csproj" Private="false" />
    <ProjectReference Include="..\ReBuzz.Agent\ReBuzz.Agent.csproj" />
    <!-- The vendored Serilog (a submodule): net9.0 on Windows, net10.0 elsewhere (S10). -->
    <ProjectReference Include="..\3rdParty\serilog\serilog.csproj" />
    <!-- The repo's own portable binaries (not NuGet). -->
    <Reference Include="NAudio.Core"><HintPath>..\3rdParty\NAudio\NAudio.Core.dll</HintPath></Reference>
    <Reference Include="NAudio.Midi"><HintPath>..\3rdParty\NAudio\NAudio.Midi.dll</HintPath></Reference>
    <Reference Include="ICSharpCode.SharpZipLib"><HintPath>..\3rdParty\ICSharpCode.SharpZipLib.dll</HintPath></Reference>
  </ItemGroup>

</Project>
