{
 "id": "org.neobuzz.neo-learn-spectral",
 "name": "Neo Learn Spectral",
 "folder": "NeoLearnSpectral",
 "namespace": "NeoBuzz.LearnSpectral",
 "engine": "(learn)",
 "machine": "NeoLearnSpectralMachine",
 "editor": "NeoLearnSpectralEditor",
 "map": "SpectralMap",
 "kind": "instrument",
 "features": [
  "synthesizer"
 ],
 "au": "NLSp",
 "description": "Spectral resynthesis synth",
 "process": "learn",
 "tempo": true,
 "idle": false,
 "tailSeconds": 10,
 "test": {
  "changes": [
   [
    "SpectralBlur",
    "raw:600"
   ]
  ],
  "settle": 0.0,
  "tolerance": 0.003
 },
 "extra": [
  "NeoWave/Engine/Tables.cs",
  "NeoWave/Engine/WavReader.cs",
  "NeoSampler/Engine/Interpolation.cs",
  "NeoSampler/Engine/SampleData.cs",
  "NeoClipper/Engine/*.cs",
  "NeoLearn/Engine/*.cs",
  "NeoBuzz.Analysis/Loudness.cs",
  "NeoBuzz.Analysis/GainMatch.cs"
 ],
 "extraEditor": [
  "NeoLearn/LearnEditor.cs"
 ],
 "gear": "Neo Learn Spectral",
 "tables": true
}
