{
 "id": "org.neobuzz.neo-learn-vector",
 "name": "Neo Learn Vector",
 "folder": "NeoLearnVector",
 "namespace": "NeoBuzz.LearnVector",
 "engine": "(learn)",
 "machine": "NeoLearnVectorMachine",
 "editor": "NeoLearnVectorEditor",
 "map": "VectorMap",
 "kind": "instrument",
 "features": [
  "synthesizer"
 ],
 "au": "NLVc",
 "description": "Vector synth blending four corner sources",
 "process": "learn",
 "tempo": true,
 "idle": false,
 "tailSeconds": 10,
 "test": {
  "changes": [
   [
    "VectorX",
    "raw:800"
   ]
  ],
  "settle": 0.0,
  "tolerance": 0.003
 },
 "extra": [
  "NeoWave/Engine/Tables.cs",
  "NeoWave/Engine/WavReader.cs",
  "NeoSampler/Engine/Interpolation.cs",
  "NeoSampler/Engine/SampleData.cs",
  "NeoClipper/Engine/*.cs",
  "NeoLearn/Engine/*.cs",
  "NeoBuzz.Analysis/Loudness.cs",
  "NeoBuzz.Analysis/GainMatch.cs"
 ],
 "extraEditor": [
  "NeoLearn/LearnEditor.cs"
 ],
 "gear": "Neo Learn Vector",
 "tables": true
}
