{
 "id": "org.neobuzz.neo-learn-granular",
 "name": "Neo Learn Granular",
 "folder": "NeoLearnGranular",
 "namespace": "NeoBuzz.LearnGrain",
 "engine": "(learn)",
 "machine": "NeoLearnGranularMachine",
 "editor": "NeoLearnGranularEditor",
 "map": "GranularMap",
 "kind": "instrument",
 "features": [
  "synthesizer"
 ],
 "au": "NLGr",
 "description": "Granular synth cut from built-in samples",
 "process": "learn",
 "tempo": true,
 "idle": false,
 "tailSeconds": 10,
 "test": {
  "changes": [
   [
    "SamplePosition",
    "raw:700"
   ]
  ],
  "settle": 0.0,
  "tolerance": 0.003
 },
 "extra": [
  "NeoWave/Engine/Tables.cs",
  "NeoWave/Engine/WavReader.cs",
  "NeoSampler/Engine/Interpolation.cs",
  "NeoSampler/Engine/SampleData.cs",
  "NeoClipper/Engine/*.cs",
  "NeoLearn/Engine/*.cs",
  "NeoBuzz.Analysis/Loudness.cs",
  "NeoBuzz.Analysis/GainMatch.cs"
 ],
 "extraEditor": [
  "NeoLearn/LearnEditor.cs"
 ],
 "gear": "Neo Learn Granular",
 "tables": true
}
