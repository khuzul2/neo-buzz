{
 "id": "org.neobuzz.neo-learn-wavefolder",
 "name": "Neo Learn Wavefolder",
 "folder": "NeoLearnWavefolder",
 "namespace": "NeoBuzz.LearnFold",
 "engine": "(learn)",
 "machine": "NeoLearnWavefolderMachine",
 "editor": "NeoLearnWavefolderEditor",
 "map": "WavefolderMap",
 "kind": "instrument",
 "features": [
  "synthesizer"
 ],
 "au": "NLWf",
 "description": "Wavefolder synth",
 "process": "learn",
 "tempo": true,
 "idle": false,
 "tailSeconds": 10,
 "test": {
  "changes": [
   [
    "FoldDrive",
    "raw:800"
   ]
  ],
  "settle": 0.0,
  "tolerance": 0.003
 },
 "extra": [
  "NeoWave/Engine/Tables.cs",
  "NeoWave/Engine/WavReader.cs",
  "NeoSampler/Engine/Interpolation.cs",
  "NeoSampler/Engine/SampleData.cs",
  "NeoClipper/Engine/*.cs",
  "NeoLearn/Engine/*.cs",
  "NeoBuzz.Analysis/Loudness.cs",
  "NeoBuzz.Analysis/GainMatch.cs"
 ],
 "extraEditor": [
  "NeoLearn/LearnEditor.cs"
 ],
 "gear": "Neo Learn Wavefolder",
 "tables": true
}
