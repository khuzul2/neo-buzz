{
 "id": "org.neobuzz.neo-learn-formant",
 "name": "Neo Learn Formant",
 "folder": "NeoLearnFormant",
 "namespace": "NeoBuzz.LearnFormant",
 "engine": "(learn)",
 "machine": "NeoLearnFormantMachine",
 "editor": "NeoLearnFormantEditor",
 "map": "FormantMap",
 "kind": "instrument",
 "features": [
  "synthesizer"
 ],
