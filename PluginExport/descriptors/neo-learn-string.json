{
 "id": "org.neobuzz.neo-learn-string",
 "name": "Neo Learn String",
 "folder": "NeoLearnString",
 "namespace": "NeoBuzz.LearnString",
 "engine": "(learn)",
 "machine": "NeoLearnStringMachine",
 "editor": "NeoLearnStringEditor",
 "map": "StringMap",
 "kind": "instrument",
 "features": [
  "synthesizer"
 ],
 "au": "NLSg",
 "description": "Plucked-string synth",
 "process": "learn",
 "tempo": true,
 "idle": false,
 "tailSeconds": 10,
 "test": {
  "changes": [
   [
    "PickPosition",
    "raw:700"
   ]
  ],
  "settle": 0.0,
  "tolerance": 0.003
 },
 "extra": [
  "NeoWave/Engine/Tables.cs",
  "NeoWave/Engine/WavReader.cs",
  "NeoSampler/Engine/Interpolation.cs",
  "NeoSampler/Engine/SampleData.cs",
  "NeoClipper/Engine/*.cs",
  "NeoLearn/Engine/*.cs",
  "NeoBuzz.Analysis/Loudness.cs",
  "NeoBuzz.Analysis/GainMatch.cs"
 ],
 "extraEditor": [
  "NeoLearn/LearnEditor.cs"
 ],
 "gear": "Neo Learn String",
 "tables": true
}
