        {
          "param": "Punch",
          "weight": 2.73
        }
      ],
      "scale": 0.555,
      "offset": 1.62,
      "why": "fitted: KickXP's pitch (its source's curve: Start towards End, raised by Punch at first, floored at the note) against Neo Drums' exponential fall, over Start 100–220, notes A0–A2 and Punch 0–100 % (within 1.6 semitones, RMS)"
    },
    {
      "kind": "unit",
      "from": "T DecRate",
      "to": "Kick sweep time",
      "why": "fitted at A1 and the default shape: the fall's time constant, 23.5 ms at 30, as (30 / rate)^0.75"
    },
    {
      "kind": "sum",
      "to": "Kick decay",
      "terms": [
        {
          "param": "A DecTime",
          "weight": 2.7
        },
        {
          "param": "A RelSlope",
          "weight": 2.7
        }
      ],
      "why": "KickXP's level falls in straight lines (A DecTime, then the release to zero in 1 / A RelSlope's rate); Neo Drums' falls exponentially: its time to −60 dB 2.7 times as long falls 20 dB where KickXP's reaches zero"
    },
    {
      "kind": "unit",
      "from": "Click",
      "to": "Kick click",
      "why": "the click layer's level"
    },
    {
      "kind": "range",
      "from": "Buzz",
      "to": "Kick drive",
      "from_range": [
        0,
        1
      ],
      "to_range": [
        0,
        12
      ],
      "why": "assumed: the buzz layer folds the sine's positive half; Neo Drums' drive saturates the body (0–100 % on 0–12 dB)"
    }
  ],
