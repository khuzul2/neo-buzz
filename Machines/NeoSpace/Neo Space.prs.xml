    <Preset Machine="Neo Space">
      <Parameters>
        <Parameter Name="Room" Group="1" Index="0" Track="0" Value="7" />
        <Parameter Name="Wave" Group="1" Index="1" Track="0" Value="0" />
        <Parameter Name="Pre-delay" Group="1" Index="2" Track="0" Value="240" />
        <Parameter Name="Length" Group="1" Index="3" Track="0" Value="1000" />
        <Parameter Name="Low cut" Group="1" Index="4" Track="0" Value="354" />
        <Parameter Name="High cut" Group="1" Index="5" Track="0" Value="306" />
        <Parameter Name="Width" Group="1" Index="6" Track="0" Value="1700" />
        <Parameter Name="Reverse" Group="1" Index="7" Track="0" Value="0" />
        <Parameter Name="Mix" Group="1" Index="8" Track="0" Value="420" />
        <Parameter Name="Amount" Group="1" Index="9" Track="0" Value="1000" />
        <Parameter Name="Output" Group="1" Index="10" Track="0" Value="500" />
      </Parameters>
