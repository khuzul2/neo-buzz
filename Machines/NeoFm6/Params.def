# Neo FM6 parameters (docs/specs/machines.md §5). The order is permanent: songs and presets
# store values by position. Regenerate: python3 tools/gen-machine-params.py Machines/NeoFm6
# Operator and voice values use the DX7's own ranges (0-99 levels and rates, coarse 0-31, ...),
# so DX7 patches, SysEx banks and DX7 know-how carry over one to one.
namespace NeoBuzz.Fm6
class NeoFm6Machine
tracks 16

group Algorithm
Algorithm   "Algorithm"     0 31   0    int 1                           | Which operators modulate which (the 32 DX7 algorithms)
Feedback    "Feedback"      0 7    0    int 0                           | Self-modulation of the feedback operator (7: near saw)
OscSync     "Osc key sync"  0 1    1    switch                          | Operators restart their phase with each note
Transpose   "Transpose"     0 48   24   int -24 st signed               | Transposes the whole voice

group Pitch envelope
PegR1       "PEG rate 1"    0 99   99   int 0                           | Pitch envelope rate 1 (99: fastest)
PegR2       "PEG rate 2"    0 99   99   int 0                           | Pitch envelope rate 2 (99: fastest)
PegR3       "PEG rate 3"    0 99   99   int 0                           | Pitch envelope rate 3 (99: fastest)
PegR4       "PEG rate 4"    0 99   99   int 0                           | Pitch envelope rate 4 (99: fastest)
PegL1       "PEG level 1"   0 99   50   int 0                           | Pitch envelope level 1 (50: no shift; 0/99: about −4/+4 octaves)
PegL2       "PEG level 2"   0 99   50   int 0                           | Pitch envelope level 2 (50: no shift; 0/99: about −4/+4 octaves)
PegL3       "PEG level 3"   0 99   50   int 0                           | Pitch envelope level 3 (50: no shift; 0/99: about −4/+4 octaves)
PegL4       "PEG level 4"   0 99   50   int 0                           | Pitch envelope level 4 (50: no shift; 0/99: about −4/+4 octaves)

group LFO
LfoWave     "LFO wave"      0 5    0    enum Triangle Saw_down Saw_up Square Sine S&H | LFO waveform
LfoSpeed    "LFO speed"     0 99   35   int 0                           | LFO rate (0: 0.06 Hz, 35: about 6 Hz, 99: about 24 Hz)
LfoDelay    "LFO delay"     0 99   0    int 0                           | Time before the LFO fades in after a note
LfoPmd      "LFO pitch"     0 99   0    int 0                           | Pitch modulation depth (scaled by Pitch sens)
LfoAmd      "LFO amp"       0 99   0    int 0                           | Amplitude modulation depth (scaled by each operator's Amp sens)
LfoSync     "LFO key sync"  0 1    1    switch                          | The LFO restarts with each note
PitchSens   "Pitch sens"    0 7    3    int 0                           | How far LFO, mod wheel and aftertouch move the pitch

group Voice
VoiceMode   "Voice mode"    0 2    0    enum Poly Mono Legato           | Poly; Mono retriggers; Legato glides without retriggering
Polyphony   "Polyphony"     1 16   8    int 0                           | Notes that sound at once
Unison      "Unison"        1 4    1    int 0                           | Voices per note
UniDetune   "Uni detune"    0 1000 150  pct                             | Detune between unison voices (up to ±25 cents)
UniSpread   "Uni spread"    0 1000 600  pct                             | Stereo spread of unison voices
GlideMode   "Glide mode"    0 2    0    enum Off Always Legato          | When notes glide
Glide       "Glide"         0 1000 200  pow 0 2 3 s 3                   | Glide time
BendRange   "Bend range"    0 12   2    int 0 st                        | Pitch bend range

group Controllers
WheelPitch  "Wheel pitch"   0 99   50   int 0                           | Mod wheel → pitch modulation (vibrato from the LFO)
WheelAmp    "Wheel amp"     0 99   0    int 0                           | Mod wheel → amplitude modulation
AtPitch     "AT pitch"      0 99   0    int 0                           | Aftertouch → pitch modulation
AtAmp       "AT amp"        0 99   0    int 0                           | Aftertouch → amplitude modulation

group Output
Tone        "Tone"          0 1000 1000 freq 1000 20000                 | Gentle low-pass on the output (20 kHz: open)
Engine      "Engine"        0 1    0    enum Clean_2× Raw_1×             | Clean: 2× oversampled; Raw: the original's aliasing grit
Volume      "Volume"        0 1000 739  db -40 6 inf                    | Output level

group Operator 1
O1On      "Op1 on"       0 1    1    switch                          | Operator 1 sounds (off: silent, as on the DX7)
O1Level   "Op1 level"    0 99   99   int 0                           | Output level (carriers: loudness; modulators: brightness)
O1Mode    "Op1 mode"     0 1    0    enum Ratio Fixed                | Ratio: follows the note; Fixed: a fixed frequency
O1Coarse  "Op1 coarse"   0 31   1    int 0                           | Ratio 0.5, 1 … 31 (Fixed: 1, 10, 100, 1000 Hz)
O1Fine    "Op1 fine"     0 99   0    int 0                           | Ratio +0 … +99% (Fixed: ×1 … ×9.77)
O1Detune  "Op1 detune"   0 14   7    int -7 signed                   | Detune, −7 … +7 (about 1 cent a step at A4)
O1Wave    "Op1 wave"     0 3    0    enum Sine Half_sine Abs_sine Pulse_sine | Operator waveform (Sine: DX7)
O1R1      "Op1 rate 1"   0 99   99   int 0                           | Envelope rate 1 (99: fastest)
O1R2      "Op1 rate 2"   0 99   99   int 0                           | Envelope rate 2 (99: fastest)
O1R3      "Op1 rate 3"   0 99   99   int 0                           | Envelope rate 3 (99: fastest)
O1R4      "Op1 rate 4"   0 99   99   int 0                           | Envelope rate 4 (99: fastest)
O1L1      "Op1 level 1"  0 99   99   int 0                           | Envelope level 1
O1L2      "Op1 level 2"  0 99   99   int 0                           | Envelope level 2
O1L3      "Op1 level 3"  0 99   99   int 0                           | Envelope level 3
O1L4      "Op1 level 4"  0 99   0    int 0                           | Envelope level 4
O1Break   "Op1 break"    0 99   39   int 0                           | Keyboard scaling break point (39: C4)
O1LDepth  "Op1 L depth"  0 99   0    int 0                           | Level scaling below the break point
O1RDepth  "Op1 R depth"  0 99   0    int 0                           | Level scaling above the break point
O1LCurve  "Op1 L curve"  0 3    0    enum -Lin -Exp +Exp +Lin        | Scaling curve below the break point
O1RCurve  "Op1 R curve"  0 3    0    enum -Lin -Exp +Exp +Lin        | Scaling curve above the break point
O1RateSc  "Op1 rate sc"  0 7    0    int 0                           | Envelopes run faster for higher notes
O1AmpSens "Op1 amp sens" 0 3    0    int 0                           | How much LFO / wheel / aftertouch amplitude modulation applies
O1VelSens "Op1 vel sens" 0 7    0    int 0                           | How much velocity changes the level

group Operator 2
O2On      "Op2 on"       0 1    1    switch                          | Operator 2 sounds (off: silent, as on the DX7)
O2Level   "Op2 level"    0 99   0    int 0                           | Output level (carriers: loudness; modulators: brightness)
O2Mode    "Op2 mode"     0 1    0    enum Ratio Fixed                | Ratio: follows the note; Fixed: a fixed frequency
O2Coarse  "Op2 coarse"   0 31   1    int 0                           | Ratio 0.5, 1 … 31 (Fixed: 1, 10, 100, 1000 Hz)
O2Fine    "Op2 fine"     0 99   0    int 0                           | Ratio +0 … +99% (Fixed: ×1 … ×9.77)
O2Detune  "Op2 detune"   0 14   7    int -7 signed                   | Detune, −7 … +7 (about 1 cent a step at A4)
O2Wave    "Op2 wave"     0 3    0    enum Sine Half_sine Abs_sine Pulse_sine | Operator waveform (Sine: DX7)
O2R1      "Op2 rate 1"   0 99   99   int 0                           | Envelope rate 1 (99: fastest)
O2R2      "Op2 rate 2"   0 99   99   int 0                           | Envelope rate 2 (99: fastest)
O2R3      "Op2 rate 3"   0 99   99   int 0                           | Envelope rate 3 (99: fastest)
O2R4      "Op2 rate 4"   0 99   99   int 0                           | Envelope rate 4 (99: fastest)
O2L1      "Op2 level 1"  0 99   99   int 0                           | Envelope level 1
O2L2      "Op2 level 2"  0 99   99   int 0                           | Envelope level 2
O2L3      "Op2 level 3"  0 99   99   int 0                           | Envelope level 3
O2L4      "Op2 level 4"  0 99   0    int 0                           | Envelope level 4
O2Break   "Op2 break"    0 99   39   int 0                           | Keyboard scaling break point (39: C4)
O2LDepth  "Op2 L depth"  0 99   0    int 0                           | Level scaling below the break point
O2RDepth  "Op2 R depth"  0 99   0    int 0                           | Level scaling above the break point
O2LCurve  "Op2 L curve"  0 3    0    enum -Lin -Exp +Exp +Lin        | Scaling curve below the break point
O2RCurve  "Op2 R curve"  0 3    0    enum -Lin -Exp +Exp +Lin        | Scaling curve above the break point
O2RateSc  "Op2 rate sc"  0 7    0    int 0                           | Envelopes run faster for higher notes
O2AmpSens "Op2 amp sens" 0 3    0    int 0                           | How much LFO / wheel / aftertouch amplitude modulation applies
O2VelSens "Op2 vel sens" 0 7    0    int 0                           | How much velocity changes the level

group Operator 3
O3On      "Op3 on"       0 1    1    switch                          | Operator 3 sounds (off: silent, as on the DX7)
O3Level   "Op3 level"    0 99   0    int 0                           | Output level (carriers: loudness; modulators: brightness)
O3Mode    "Op3 mode"     0 1    0    enum Ratio Fixed                | Ratio: follows the note; Fixed: a fixed frequency
O3Coarse  "Op3 coarse"   0 31   1    int 0                           | Ratio 0.5, 1 … 31 (Fixed: 1, 10, 100, 1000 Hz)
O3Fine    "Op3 fine"     0 99   0    int 0                           | Ratio +0 … +99% (Fixed: ×1 … ×9.77)
O3Detune  "Op3 detune"   0 14   7    int -7 signed                   | Detune, −7 … +7 (about 1 cent a step at A4)
O3Wave    "Op3 wave"     0 3    0    enum Sine Half_sine Abs_sine Pulse_sine | Operator waveform (Sine: DX7)
O3R1      "Op3 rate 1"   0 99   99   int 0                           | Envelope rate 1 (99: fastest)
O3R2      "Op3 rate 2"   0 99   99   int 0                           | Envelope rate 2 (99: fastest)
O3R3      "Op3 rate 3"   0 99   99   int 0                           | Envelope rate 3 (99: fastest)
O3R4      "Op3 rate 4"   0 99   99   int 0                           | Envelope rate 4 (99: fastest)
O3L1      "Op3 level 1"  0 99   99   int 0                           | Envelope level 1
O3L2      "Op3 level 2"  0 99   99   int 0                           | Envelope level 2
O3L3      "Op3 level 3"  0 99   99   int 0                           | Envelope level 3
O3L4      "Op3 level 4"  0 99   0    int 0                           | Envelope level 4
O3Break   "Op3 break"    0 99   39   int 0                           | Keyboard scaling break point (39: C4)
O3LDepth  "Op3 L depth"  0 99   0    int 0                           | Level scaling below the break point
O3RDepth  "Op3 R depth"  0 99   0    int 0                           | Level scaling above the break point
O3LCurve  "Op3 L curve"  0 3    0    enum -Lin -Exp +Exp +Lin        | Scaling curve below the break point
O3RCurve  "Op3 R curve"  0 3    0    enum -Lin -Exp +Exp +Lin        | Scaling curve above the break point
O3RateSc  "Op3 rate sc"  0 7    0    int 0                           | Envelopes run faster for higher notes
O3AmpSens "Op3 amp sens" 0 3    0    int 0                           | How much LFO / wheel / aftertouch amplitude modulation applies
O3VelSens "Op3 vel sens" 0 7    0    int 0                           | How much velocity changes the level

