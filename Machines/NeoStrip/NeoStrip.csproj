<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fork addition (neo-buzz, docs/specs/mastering-tools.md §5): Neo Strip. Shared DSP, Buzz glue and editor kit are linked as source. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Neo Strip.NET</AssemblyName>
    <RootNamespace>NeoBuzz.Strip</RootNamespace>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<OutputPath>$(SolutionDir)bin\$(Configuration)\$(Platform)\$(TargetFramework)\Gear\Effects</OutputPath>
	<IntermediateOutputPath>$(SolutionDir)build\$(Configuration)\$(Platform)\NeoStrip\obj</IntermediateOutputPath>
	<Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>MSB3277;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\NeoBuzz.Dsp\**\*.cs" Link="Shared\Dsp\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\NeoBuzz.Machine\**\*.cs" Link="Shared\Machine\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\NeoBuzz.Editor\**\*.cs" Link="Shared\Editor\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The gain-match reading (mastering-tools.md §2), shared with the agent server's meters. -->
    <Compile Include="..\NeoBuzz.Analysis\Loudness.cs;..\NeoBuzz.Analysis\GainMatch.cs" Link="Shared\Analysis\%(Filename)%(Extension)" />
    <!-- Neo Strip is built from these machines' engines, linked as source (docs/specs/mastering-tools.md §5.10). -->
    <Compile Include="..\NeoEq\Engine\*.cs" Link="Shared\Eq\%(Filename)%(Extension)" />
    <Compile Include="..\NeoComp\Engine\*.cs" Link="Shared\Comp\%(Filename)%(Extension)" />
    <Compile Include="..\NeoDrive\Engine\*.cs" Link="Shared\Drive\%(Filename)%(Extension)" />
    <Compile Include="..\NeoClipper\Engine\*.cs" Link="Shared\Clipper\%(Filename)%(Extension)" />
    <Compile Include="..\NeoLimiter\Engine\*.cs" Link="Shared\Limiter\%(Filename)%(Extension)" />
    <None Include="Params.def" />
    <None Include="Neo Strip.prs.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Neo Strip.machine.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\..\ReBuzzGUI\BuzzGUI.Common\BuzzGUI.Common.csproj" />
	  <ProjectReference Include="..\..\ReBuzzGUI\BuzzGUI.Interfaces\BuzzGUI.Interfaces.csproj" />
  </ItemGroup>

  <Target Name="ForcePerformRestore" AfterTargets="BeforeBuild">
	  <Exec Command="IF NOT EXIST  &quot;$(IntermediateOutputPath)project.assets.json&quot;  echo restore to $(IntermediateOutputPath)project.assets.json &amp;&amp;  dotnet restore &quot;$(ProjectName).csproj&quot;  --no-dependencies &amp;&amp; move &quot;build\$(ProjectName)\obj\*&quot; &quot;$(IntermediateOutputPath)&quot; &amp;&amp; rmdir /Q /S build	 " />
  </Target>

  <Target Name="RemoveEmptyObj" AfterTargets="AfterBuild">
	  <Exec Command="IF EXIST obj rmdir obj" />
  </Target>

</Project>
