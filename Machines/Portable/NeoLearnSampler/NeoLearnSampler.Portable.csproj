<Project Sdk="Microsoft.NET.Sdk">
  <!-- Neo Learn Sampler, portable (docs/specs/mac-engine.md M2): see ../NeoPortable.targets. -->
  <PropertyGroup>
    <NeoFolder>NeoLearnSampler</NeoFolder>
    <NeoName>Neo Learn Sampler</NeoName>
    <NeoKind>Generators</NeoKind>
  </PropertyGroup>
  <Import Project="../NeoPortable.targets" />
  <ItemGroup>
    <!-- Dye Essence's engine, hosted by LearnHost, with what its Analog engine reads (Neo Wave's table recipes, Neo Sampler's sample layer). -->
    <Compile Include="$(M)DyeEssence\Engine\**\*.cs" Link="Shared\DyeEssence\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The effects rack (docs/specs/dye-essence.md §4.10) hosts these machines' engines, linked as source: the gain-match reading and each engine. -->
    <Compile Include="$(M)NeoBuzz.Analysis\Loudness.cs;$(M)NeoBuzz.Analysis\GainMatch.cs" Link="Shared\Analysis\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoEq\Engine\*.cs" Link="Shared\Eq\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoFilter\Engine\*.cs" Link="Shared\Filter\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoComp\Engine\*.cs" Link="Shared\Comp\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoClipper\Engine\*.cs" Link="Shared\Clipper\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoDelay\Engine\*.cs" Link="Shared\Delay\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoVerb\Engine\*.cs" Link="Shared\Verb\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoLearn\**\*.cs" Exclude="$(M)NeoLearn\**\*Editor.cs;$(M)NeoLearn\obj\**;$(M)NeoLearn\bin\**" Link="Shared\Learn\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoWave\Engine\Tables.cs;$(M)NeoWave\Engine\WavReader.cs" Link="Shared\NeoWave\%(Filename)%(Extension)" />
    <Compile Include="$(M)NeoSampler\Engine\Interpolation.cs;$(M)NeoSampler\Engine\SampleData.cs" Link="Shared\NeoSampler\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
