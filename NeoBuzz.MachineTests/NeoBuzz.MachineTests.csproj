<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork addition (docs/specs/machines.md §3): measurement tests for the Neo machines' DSP. Links
    the shared DSP library and every machine's Engine folder (all pure C#), so the tests run on
    Linux CI in seconds and need no ReBuzz build. Not part of ReBuzz.sln on purpose.

      dotnet test NeoBuzz.MachineTests
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NeoBuzz.MachineTests</RootNamespace>
    <!-- Measurements are heavy: run them optimised even in Debug, and fully optimised from the
         first call (no tier-0 code), so CPU figures don't depend on when the JIT tiers up. -->
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Machines\NeoBuzz.Dsp\**\*.cs" Link="Dsp\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Machines\Neo*\Engine\**\*.cs" Link="Engines\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Dye Essence (docs/specs/dye-essence.md): a Neo-family machine with its own name. -->
    <Compile Include="..\Machines\DyeEssence\Engine\**\*.cs" Link="Engines\DyeEssence\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Neo Analyzer measures with the analysis library (docs/specs/mcp-server.md §7): its streaming
         meters, FFT, bands and stereo measures, checked here against the library's batch measures. -->
    <Compile Include="..\Machines\NeoBuzz.Analysis\LoudnessMeter.cs;..\Machines\NeoBuzz.Analysis\Fft.cs;..\Machines\NeoBuzz.Analysis\Spectrum.cs;..\Machines\NeoBuzz.Analysis\Stereo.cs;..\Machines\NeoBuzz.Analysis\GainMatch.cs" Link="Analysis\%(Filename)%(Extension)" />
    <!-- The editor kit's toolkit-free core (docs/specs/cross-platform.md §8.3): canvas, layout,
         hit-testing and graphs. Compiling it here keeps it free of WPF. -->
    <Compile Include="..\Machines\NeoBuzz.Editor\Core\**\*.cs" Link="EditorCore\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The manifest editor's face (docs/specs/mcp-server.md §12.11, U4): planning, pictures and response models,
         toolkit-free and engine-free like the kit's core. -->
    <Compile Include="..\Machines\NeoBuzz.ManifestEditor\Core\**\*.cs" Link="ManifestEditor\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The keyboard names its keys as Preferences name notes (docs/specs/ux-overhaul.md §3.5); pure, by name. -->
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Common\NoteNames.cs" Link="ManifestEditor\NoteNames.cs" />
    <!-- The analysis library's BS.1770 true peak: Neo Limiter's ceiling is measured with what the
         agent server measures with (docs/specs/mcp-server.md §7). Only this file, by name. -->
    <Compile Include="..\Machines\NeoBuzz.Analysis\Loudness.cs" Link="Analysis\Loudness.cs" />
    <!-- The zero-allocation tests measure each block with the engine tests' AllocationWindow (AllocationCheck.cs). -->
    <Compile Include="..\ReBuzzTests\Automation\AllocationWindow.cs" Link="Automation\AllocationWindow.cs" />
    <!-- The throughput guards time a render against a reference workload in the same run (Throughput.cs; machines.md §6). -->
    <Compile Include="..\ReBuzzTests\Automation\Throughput.cs" Link="Automation\Throughput.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="ReBuzzTests.Automation" />
  </ItemGroup>

</Project>
