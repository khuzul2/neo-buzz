<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork addition: fast, platform-independent tests for the Session View engine core.
    Compiles ReBuzz/Core/Session/SessionScheduler.cs and SessionDocument.cs directly (they have
    no other ReBuzz dependencies), so these run on Linux CI in seconds and need no ReBuzz build.
    Not part of ReBuzz.sln on purpose: build.ps1 and the upstream workflows are unaffected.

      dotnet test ReBuzz.SessionTests
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ReBuzz.SessionTests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Fork (docs/specs/daw-modes.md §8.1): methods with loops compiled fully optimised at once, so the audio
       thread never compiles an on-stack replacement (tools/msbuild/AudioThreadRuntime.props). -->
  <Import Project="..\tools\msbuild\AudioThreadRuntime.props" />

  <ItemGroup>
    <Compile Include="..\ReBuzzTests\Automation\GuardPolicy.cs" Link="Automation\GuardPolicy.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionScheduler.cs" Link="Engine\SessionScheduler.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionDocument.cs" Link="Engine\SessionDocument.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionMidiMap.cs" Link="Engine\SessionMidiMap.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionTake.cs" Link="Engine\SessionTake.cs" />
    <Compile Include="..\ReBuzz\Core\Session\TrackInputs.cs" Link="Engine\TrackInputs.cs" />
    <Compile Include="..\ReBuzz\Midi\MidiDevice.cs" Link="Engine\MidiDevice.cs" />
    <Compile Include="..\ReBuzz\Midi\Mapping\*.cs" Link="Engine\Mapping\%(Filename)%(Extension)" />
    <Compile Include="..\ReBuzz\Audio\EngineInput.cs" Link="Engine\EngineInput.cs" />
    <Compile Include="..\ReBuzz\Core\Session\ClipNotes.cs" Link="Engine\ClipNotes.cs" />
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Common\TrackerNotes.cs" Link="Engine\TrackerNotes.cs" />
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Common\NoteLanes.cs" Link="Engine\NoteLanes.cs" />
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Common\NoteNames.cs" Link="Engine\NoteNames.cs" />
    <!-- The machine delay compensation's ring and plan (docs/specs/mastering-tools.md §4.1), with the Sample they carry. -->
    <Compile Include="..\ReBuzz\Core\Tracks\TrackModel.cs" Link="Engine\TrackModel.cs" />
    <Compile Include="..\ReBuzz\Core\LatencyRing.cs;..\ReBuzz\Core\LatencyPlan.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Interfaces\MachineInterface\Sample.cs" Link="Engine\Sample.cs" />
    <Compile Include="..\ReBuzz\Core\Sync\SyncTime.cs" Link="Engine\SyncTime.cs" />
    <Compile Include="..\ReBuzz\Core\Sync\MidiClock.cs" Link="Engine\MidiClock.cs" />
    <Compile Include="..\ReBuzz\Core\Sync\SyncClock.cs" Link="Engine\SyncClock.cs" />
    <Compile Include="..\ReBuzz\Core\Control\ControlSurface.cs" Link="Engine\ControlSurface.cs" />
    <Compile Include="..\ReBuzz\Core\Control\BuiltInScripts.cs" Link="Engine\BuiltInScripts.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioClip.cs" Link="Engine\AudioClip.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioAnalysis.cs" Link="Engine\AudioAnalysis.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\SliceMath.cs" Link="Engine\SliceMath.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioAnalysis.AutoWarp.cs;..\ReBuzz\Core\Clips\BeatTracker.cs;..\ReBuzz\Core\Clips\AutoWarpPolicy.cs;..\ReBuzz\Core\Clips\BeatFront.cs;..\ReBuzz\Core\Clips\BeatModelNet.cs;..\ReBuzz\Core\Clips\BeatModelTracker.cs;..\ReBuzz\Core\Clips\BeatThisFront.cs;..\ReBuzz\Core\Clips\BeatThisModel.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\ReBuzz\Core\Clips\WarpEditing.cs" Link="Engine\WarpEditing.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioCapture.cs" Link="Engine\AudioCapture.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\TakeFile.cs" Link="Engine\TakeFile.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\ClipMixer.cs" Link="Engine\ClipMixer.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\ClipVoice.cs" Link="Engine\ClipVoice.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\Fft.cs" Link="Engine\Fft.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\PhaseVocoder.cs" Link="Engine\PhaseVocoder.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\NeoStretch.cs" Link="Engine\NeoStretch.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\PeriodicStretch.cs" Link="Engine\PeriodicStretch.cs" />
    <Compile Include="..\ReBuzz\Core\AudioLibrary\AudioAsset.cs" Link="Engine\AudioAsset.cs" />
    <Compile Include="..\ReBuzz\Core\AudioLibrary\AudioCache.cs" Link="Engine\AudioCache.cs" />
    <Compile Include="..\ReBuzz\Core\AudioLibrary\StreamedAudio.cs" Link="Engine\StreamedAudio.cs" />
    <Compile Include="..\ReBuzz\Core\AudioLibrary\PeakCache.cs" Link="Engine\PeakCache.cs" />
    <Compile Include="..\ReBuzz\Core\AudioLibrary\Resampler.cs" Link="Engine\Resampler.cs" />
    <Compile Include="..\ReBuzz\Core\AudioLibrary\AudioImporter.cs" Link="Engine\AudioImporter.cs" />
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Common\libsndfile\SoundFile.cs" Link="Engine\SoundFile.cs" />
    <!-- Stem separation (docs/specs/stem-separation.md): the transform, the chunker, the model files and the ONNX Runtime passes. -->
    <Compile Include="..\ReBuzz\Core\AudioLibrary\Stems\*.cs" Link="Engine\Stems\%(Filename)%(Extension)" />
    <!-- Convert to MIDI (docs/specs/pitch.md section 9): the converters, the shared pitch engine they use, and the Basic Pitch model. -->
    <Compile Include="..\ReBuzz\Core\AudioLibrary\AudioToMidi\*.cs" Link="Engine\AudioToMidi\%(Filename)%(Extension)" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\PitchTracker.cs" Link="Engine\Dsp\PitchTracker.cs" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\OnsetDetector.cs" Link="Engine\Dsp\OnsetDetector.cs" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\TriggerClassifier.cs" Link="Engine\Dsp\TriggerClassifier.cs" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\ComplexFft.cs" Link="Engine\Dsp\ComplexFft.cs" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\PortableMath.cs" Link="Engine\Dsp\PortableMath.cs" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\Filters.cs" Link="Engine\Dsp\Filters.cs" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\DspMath.cs" Link="Engine\Dsp\DspMath.cs" />
    <EmbeddedResource Include="..\3rdParty\basic-pitch\nmp.onnx" LogicalName="ReBuzz.BasicPitch.nmp.onnx" Link="Engine\nmp.onnx" />
    <!-- Song Notes' formats (docs/specs/machine-safety.md §3.5): Markdown, the RTF reader, Info's saved state. -->
    <Compile Include="..\ReBuzz\Core\Notes\NotesMarkdown.cs;..\ReBuzz\Core\Notes\RtfToMarkdown.cs;..\ReBuzz\Core\Notes\InfoMachineState.cs" Link="Engine\%(Filename)%(Extension)" />
    <!-- The seams for hosts without Windows or a UI toolkit (docs/specs/mac-engine.md M0), with the interfaces they implement. -->
    <Compile Include="..\ReBuzz\Platform\*.cs" Link="Platform\%(Filename)%(Extension)" />
    <!-- The app's name (NeoBuzz Live), which the seams' messages and CoreMIDI's names use. -->
    <Compile Include="..\ReBuzz.Agent\Product.cs" Link="Platform\Product.cs" />
    <Compile Include="..\ReBuzz\Core\IRegistryEx.cs;..\ReBuzz\Core\IRegistryKey.cs;..\ReBuzz\Core\IUiDispatcher.cs;..\ReBuzz\Core\IUiSignal.cs;..\ReBuzz\Core\IUiTimer.cs;..\ReBuzz\Core\IUserMessages.cs;..\ReBuzzGUI\BuzzGUI.Common\IRegistryStore.cs" Link="Platform\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Neo Audio's Pro warp mode (docs/specs/neo-audio.md section 11): the native neostretch library, once built with CMake
       (NeoStretch/CMakeLists.txt, into build/NeoStretch), beside the tests, where NativeLibraries looks first. Without it the tests of
       Pro that need it fail by name (NeoStretchTests), they are not skipped. -->
  <ItemGroup>
    <None Include="..\build\NeoStretch\libneostretch.so" Condition="Exists('..\build\NeoStretch\libneostretch.so')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="..\build\NeoStretch\libneostretch.dylib" Condition="Exists('..\build\NeoStretch\libneostretch.dylib')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="..\build\NeoStretch\neostretch.dll" Condition="Exists('..\build\NeoStretch\neostretch.dll')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="..\build\NeoStretch\Release\neostretch.dll" Condition="Exists('..\build\NeoStretch\Release\neostretch.dll')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Stems\Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Convert\Data\*.json" CopyToOutputDirectory="PreserveNewest" Link="Convert\Data\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="ReBuzzTests.Automation" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AutoWarp\aw2-parity.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="AutoWarp\beat-this-golden.bin;AutoWarp\beat-this-golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
