<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork addition: fast, platform-independent tests for the Session View engine core.
    Compiles ReBuzz/Core/Session/SessionScheduler.cs and SessionDocument.cs directly (they have
    no other ReBuzz dependencies), so these run on Linux CI in seconds and need no ReBuzz build.
    Not part of ReBuzz.sln on purpose: build.ps1 and the upstream workflows are unaffected.

      dotnet test ReBuzz.SessionTests
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ReBuzz.SessionTests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReBuzz\Core\Session\SessionScheduler.cs" Link="Engine\SessionScheduler.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionDocument.cs" Link="Engine\SessionDocument.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionMidiMap.cs" Link="Engine\SessionMidiMap.cs" />
    <Compile Include="..\ReBuzz\Core\Session\SessionTake.cs" Link="Engine\SessionTake.cs" />
    <Compile Include="..\ReBuzz\Core\Session\ClipNotes.cs" Link="Engine\ClipNotes.cs" />
    <Compile Include="..\ReBuzzGUI\BuzzGUI.Common\TrackerNotes.cs" Link="Engine\TrackerNotes.cs" />
    <Compile Include="..\ReBuzz\Core\Sync\SyncTime.cs" Link="Engine\SyncTime.cs" />
    <Compile Include="..\ReBuzz\Core\Sync\MidiClock.cs" Link="Engine\MidiClock.cs" />
    <Compile Include="..\ReBuzz\Core\Sync\SyncClock.cs" Link="Engine\SyncClock.cs" />
    <Compile Include="..\ReBuzz\Core\Control\ControlSurface.cs" Link="Engine\ControlSurface.cs" />
    <Compile Include="..\ReBuzz\Core\Control\BuiltInScripts.cs" Link="Engine\BuiltInScripts.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioClip.cs" Link="Engine\AudioClip.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioAnalysis.cs" Link="Engine\AudioAnalysis.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\AudioCapture.cs" Link="Engine\AudioCapture.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\ClipMixer.cs" Link="Engine\ClipMixer.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\ClipVoice.cs" Link="Engine\ClipVoice.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\Fft.cs" Link="Engine\Fft.cs" />
    <Compile Include="..\ReBuzz\Core\Clips\PhaseVocoder.cs" Link="Engine\PhaseVocoder.cs" />
    <!-- The seams for hosts without Windows or a UI toolkit (docs/specs/mac-engine.md M0), with the interfaces they implement. -->
    <Compile Include="..\ReBuzz\Platform\*.cs" Link="Platform\%(Filename)%(Extension)" />
    <Compile Include="..\ReBuzz\Core\IRegistryEx.cs;..\ReBuzz\Core\IRegistryKey.cs;..\ReBuzz\Core\IUiDispatcher.cs;..\ReBuzz\Core\IUiTimer.cs;..\ReBuzz\Core\IUserMessages.cs" Link="Platform\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
