<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork addition (docs/specs/neo-audio.md, AW1 as built): scores auto-warp (ReBuzz/Core/Clips/BeatTracker.cs and AudioAnalysis.AutoWarp.cs, as the app runs
    them) against today's steady-tempo detection, for the autowarp job of .github/workflows/pitch-eval.yml. It writes each file's beats, downbeats and
    grid errors as JSON; tools/autowarp/score.py scores them (mir_eval, MIT). The data are fetched by tools/autowarp/fetch_data.py on the runner; nothing
    is committed. Links the analysis and what it reads (the audio source, the FFT) and nothing else of ReBuzz. Not part of ReBuzz.sln.

      run it with: dotnet run, configuration Release, project tools/AutoWarpEval (the arguments are in Program.cs)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NeoBuzz.AutoWarpEval</RootNamespace>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\ReBuzz\Core\Clips\AudioClip.cs;..\..\ReBuzz\Core\Clips\AudioAnalysis.cs;..\..\ReBuzz\Core\Clips\AudioAnalysis.AutoWarp.cs;..\..\ReBuzz\Core\Clips\BeatTracker.cs;..\..\ReBuzz\Core\Clips\Fft.cs;..\..\ReBuzz\Core\Clips\BeatFront.cs;..\..\ReBuzz\Core\Clips\BeatModelNet.cs;..\..\ReBuzz\Core\Clips\BeatModelTracker.cs;..\..\ReBuzz\Core\Clips\BeatModelData.cs;..\..\ReBuzz\Core\Clips\WarpEditing.cs;..\..\ReBuzz\Core\Clips\GridWarp.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\..\ReBuzz\Core\AudioLibrary\AudioCache.cs;..\..\ReBuzz\Core\AudioLibrary\StreamedAudio.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\..\ReBuzz.SessionTests\AutoWarp\WarpSignals.cs" Link="WarpSignals.cs" />
    <Compile Include="..\PitchEval\Wav.cs" Link="Wav.cs" />
    <!-- AW3: the shared onset detector (docs/specs/pitch.md section 3) and what it uses. -->
    <Compile Include="..\..\Machines\NeoBuzz.Dsp\OnsetDetector.cs;..\..\Machines\NeoBuzz.Dsp\ComplexFft.cs;..\..\Machines\NeoBuzz.Dsp\PortableMath.cs;..\..\Machines\NeoBuzz.Dsp\Filters.cs;..\..\Machines\NeoBuzz.Dsp\DspMath.cs" Link="Dsp\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
