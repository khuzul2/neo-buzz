<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork addition (docs/specs/pitch.md §7): scores the shared pitch engine on real recordings, for the pitch-eval workflow
    (.github/workflows/pitch-eval.yml). Links the shared DSP library, Neo Tune's engine and the Neo Voice to MIDI engine (no host types) and nothing else, so it builds and runs anywhere .NET does.
    The data are downloaded by the workflow on the runner and read from there; nothing is committed. Not part of ReBuzz.sln.

      run it with: dotnet run, configuration Release, project tools/PitchEval (the arguments are in Program.cs)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NeoBuzz.PitchEval</RootNamespace>
    <Optimize>true</Optimize>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Machines\NeoBuzz.Dsp\**\*.cs" Link="Dsp\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Machines\NeoVoiceToMidi\Engine\**\*.cs" Link="VoiceToMidi\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Neo Audio to MIDI's engine (docs/specs/audio-to-midi.md §8): the notes and drum hits as the machine makes them, evaluated on GuitarSet, IDMT-SMT-Drums and MDB-stem-synth (Am1.cs). -->
    <Compile Include="..\..\Machines\NeoAudioToMidi\Engine\**\*.cs" Link="AudioToMidi\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Neo Tune's engine (docs/specs/neo-tune.md §9): the corrector as the machine runs it, evaluated on VocalSet (Tune.cs). -->
    <Compile Include="..\..\Machines\NeoTune\Engine\*.cs" Link="Tune\%(Filename)%(Extension)" />
    <!-- TuneQuality.cs (the metrics, also run by the machine tests) and TuneNt1\ (NT1's engine frozen as it shipped, for the before/after comparison) are compiled with the project (TuneGates.cs). -->
  </ItemGroup>

</Project>
