<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork (docs/specs/mac-engine.md M1): rebuzz-headless, the engine with the MCP server on stdio
    and no UI toolkit. It runs on macOS, Linux and Windows: the Mac engine's first product, and
    the cheap Linux stand-in for it in CI. ReBuzz.exe stays the Windows app (its own `- -agent`).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rebuzz-headless</AssemblyName>
    <RootNamespace>ReBuzz.Headless</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Fork (docs/specs/daw-modes.md §8.1): methods with loops compiled fully optimised at once, so the audio
       thread never compiles an on-stack replacement (tools/msbuild/AudioThreadRuntime.props). -->
  <Import Project="..\tools\msbuild\AudioThreadRuntime.props" />

  <ItemGroup>
    <!-- The engine's start-up off WPF, shared with the studio (docs/specs/studio-mvp.md §2). -->
    <ProjectReference Include="..\ReBuzz.Host\ReBuzz.Host.csproj" />
  </ItemGroup>

  <!-- The Neo machines (no editors) in Gear, and the Link helper beside the app. -->
  <Import Project="..\ReBuzz.Host\AppGear.targets" />

</Project>
