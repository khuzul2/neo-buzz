<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork (docs/specs/mac-engine.md M1): rebuzz-headless, the engine with the MCP server on stdio
    and no UI toolkit. It runs on macOS, Linux and Windows: the Mac engine's first product, and
    the cheap Linux stand-in for it in CI. ReBuzz.exe stays the Windows app (its own `- -agent`).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rebuzz-headless</AssemblyName>
    <RootNamespace>ReBuzz.Headless</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReBuzz.Engine\ReBuzz.Engine.csproj" />
    <!-- The engine references the portable machine API without copying it; the app ships it. -->
    <ProjectReference Include="..\ReBuzzGUI\BuzzGUI.Interfaces\BuzzGUI.Interfaces.csproj" />
    <ProjectReference Include="..\ReBuzzGUI\BuzzGUI.Common\BuzzGUI.Common.csproj" />
  </ItemGroup>

  <!-- The Neo machines, built for net10.0 (no editors), in the app's Gear folder (mac-engine.md M2). -->
  <Target Name="NeoGear" AfterTargets="Build" Condition="'$(SkipNeoGear)' != 'true'">
    <MSBuild Projects="..\Machines\Portable\Portable.proj" Properties="GearDir=$(MSBuildProjectDirectory)/$(OutDir)Gear/;Configuration=$(Configuration)" />
  </Target>

</Project>
