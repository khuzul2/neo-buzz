<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>Pedal Gate.NET</AssemblyName>
    <RootNamespace>WDE.PedalGate</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>

    <!--
      Output goes straight into the ReBuzz Effects gear folder.
      $(BuzzDir) defaults to the standard install path; override on the
      command line if ReBuzz lives elsewhere:

        dotnet build PedalGate.csproj -c Release /p:BuzzDir="D:\MyReBuzz"
    -->
    <BuzzDir Condition="'$(BuzzDir)' == ''">$(ReBuzzDir)</BuzzDir>
    <OutputPath>$(BuzzDir)\Gear\Effects\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <AssemblyTitle>Pedal Gate</AssemblyTitle>
    <Company>WDE</Company>
    <Product>Pedal Gate</Product>
    <Copyright>© 2025 WDE</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    ReBuzz managed-machine API DLLs.
    These are NOT on NuGet — they ship with ReBuzz.
    Private=false keeps them out of the output folder (ReBuzz already
    has them on its probing path at runtime).
  -->
  <ItemGroup>
    <!-- IBuzzMachine, MachineDecl, ParameterDecl, IBuzzMachineHost, Sample, WorkModes -->
    <Reference Include="ReBuzz">
      <HintPath>$(BuzzDir)\ReBuzz.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BuzzGUI types used by the managed machine infrastructure -->
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Common">
      <HintPath>$(BuzzDir)\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
