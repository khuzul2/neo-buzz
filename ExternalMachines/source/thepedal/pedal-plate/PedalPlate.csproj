<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyName>Pedal Plate.NET</AssemblyName>
    <RootNamespace>WDE.PedalPlate</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>

    <!--
      ReBuzz install location. Defaults to the standard install path.
      Override on the command line if ReBuzz lives elsewhere:
        dotnet build PedalPlate.csproj -c Release /p:BuzzDir="D:\ReBuzz"
    -->
    <BuzzDir Condition="'$(BuzzDir)' == ''">$(ReBuzzDir)</BuzzDir>
    <OutputPath>$(BuzzDir)\Gear\Effects\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <AssemblyTitle>Pedal Plate</AssemblyTitle>
    <Company>WDE</Company>
    <Product>Pedal Plate</Product>
    <Copyright>© 2025 WDE</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    ReBuzz managed-machine API DLLs — not on NuGet, they ship with ReBuzz.
    Private=false means they are NOT copied to the output folder
    (ReBuzz already has them at runtime).
  -->
  <ItemGroup>
    <Reference Include="ReBuzz">
      <HintPath>$(BuzzDir)\ReBuzz.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Common">
      <HintPath>$(BuzzDir)\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
