<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>Pedal Tracker.NET</AssemblyName>
    <RootNamespace>WDE.PedalTracker</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <!--
      Output goes straight into the ReBuzz Generators gear folder.
      Override BuzzDir on the command line if ReBuzz is installed elsewhere:
        dotnet build PedalTracker.csproj -c Release /p:BuzzDir="D:\ReBuzz"
    -->
    <BuzzDir Condition="'$(BuzzDir)' == ''">$(ReBuzzDir)</BuzzDir>
    <OutputPath>$(BuzzDir)\Gear\Generators</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <AssemblyTitle>Pedal Tracker</AssemblyTitle>
    <Company>WDE</Company>
    <Product>Pedal Tracker</Product>
    <Copyright>© WDE</Copyright>
    <Version>1.7.3</Version>
  </PropertyGroup>

  <!--
    ReBuzz managed-machine API DLLs – not on NuGet, they ship with ReBuzz.
    Private=false means they will NOT be copied into the output folder
    (ReBuzz already has them at runtime).
  -->
  <ItemGroup>
    <!-- Buzz.MachineInterface: IBuzzMachine, MachineDecl, ParameterDecl,
                                IBuzzMachineHost, Sample, WorkModes, Note -->
    <Reference Include="ReBuzz">
      <HintPath>$(BuzzDir)\ReBuzz.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BuzzGUI types: IMachine, IWave, IWaveLayer, IWavetable, IBuzz, IMenuItem -->
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
