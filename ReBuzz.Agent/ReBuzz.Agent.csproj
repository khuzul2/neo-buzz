<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork addition (docs/specs/mcp-server.md): the agent server's portable core. The MCP protocol
    (JSON-RPC over stdio and Streamable HTTP), tool/prompt/resource registries, the engine queue,
    units and the agent log. Plain net10.0 with no UI and no NuGet packages, so it builds and is
    tested on Linux (ReBuzz.AgentTests) and runs on macOS later. The ReBuzz-specific tools live in
    ReBuzz/Agent/ and register here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReBuzz.Agent</RootNamespace>
    <AssemblyName>ReBuzz.Agent</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReBuzz.AgentTests" />
    <!-- The evaluation (docs/specs/mcp-server.md §10) measures with the analysis library. -->
    <InternalsVisibleTo Include="ReBuzz.AgentEval" />
  </ItemGroup>

  <ItemGroup>
    <!-- The craft guides (docs/specs/mcp-server.md §6), served by the guide tool and as resources. -->
    <EmbeddedResource Include="Guides\*.md" LogicalName="ReBuzz.Agent.Guides.%(Filename)%(Extension)" />
    <!-- Curated machine pages (Guides/machines/<Gear>.md), merged into rebuzz://machines/<gear>/manual. -->
    <EmbeddedResource Include="Guides\machines\*.md" LogicalName="ReBuzz.Agent.Guides.machines.%(Filename)%(Extension)" />
    <!-- Successor mappings (mcp-server.md §12.5, U5): how machine_replace moves a classic machine onto its Neo successor. -->
    <EmbeddedResource Include="..\Machines\Manifests\Successors\*.successor.json" LogicalName="ReBuzz.Agent.Successors.%(Filename)%(Extension)" Link="Successors\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analysis library (docs/specs/mcp-server.md §7), shared with the analysis machines. -->
    <Compile Include="..\Machines\NeoBuzz.Analysis\**\*.cs" Link="Analysis\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Neo EQ's design (docs/specs/mastering-tools.md §6): eq_fit fits the bands the machine runs, with the parts of the DSP library it needs. -->
    <Compile Include="..\Machines\NeoEq\Engine\EqDesign.cs;..\Machines\NeoEq\Engine\Params.g.cs" Link="NeoEq\%(Filename)%(Extension)" />
    <Compile Include="..\Machines\NeoBuzz.Dsp\ParamDef.cs;..\Machines\NeoBuzz.Dsp\PortableMath.cs;..\Machines\NeoBuzz.Dsp\Sections.cs;..\Machines\NeoBuzz.Dsp\DspMath.cs;..\Machines\NeoBuzz.Dsp\Dither.cs" Link="Dsp\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
