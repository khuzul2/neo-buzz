<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fork (docs/specs/studio-mvp.md, P3): ReBuzz's studio on Avalonia (MIT), Mac first. It hosts
    the engine as rebuzz-headless does (ReBuzz.Host) and draws the views. Free components only
    (studio-mvp.md §1): no XPF, no Pro controls, no paid tooling. Windows keeps ReBuzz.exe (WPF)
    until P4.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ReBuzz.Studio</AssemblyName>
    <RootNamespace>ReBuzz.Studio</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Fork (docs/specs/daw-modes.md §8.1): methods with loops compiled fully optimised at once, so the audio
       thread never compiles an on-stack replacement (tools/msbuild/AudioThreadRuntime.props). -->
  <Import Project="..\tools\msbuild\AudioThreadRuntime.props" />

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReBuzz.Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine's start-up off WPF, shared with rebuzz-headless. -->
    <ProjectReference Include="..\ReBuzz.Host\ReBuzz.Host.csproj" />
  </ItemGroup>

  <!-- Fork (docs/specs/mcp-server.md §12.11, U4): the manifest editor, on the Neo editor kit's Avalonia backend
       (as the Neo machines' studio flavour builds it, Machines/Studio/NeoStudio.targets): the kit, its parameter
       tables (NeoBuzz.Dsp), the editor's toolkit-free face and its one source for both front ends. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Machines\NeoBuzz.Dsp\**\*.cs" Link="ManifestEditor\Dsp\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Machines\NeoBuzz.Editor\Core\**\*.cs" Link="ManifestEditor\EditorCore\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Machines\NeoBuzz.Editor\Params\**\*.cs" Link="ManifestEditor\EditorParams\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Machines\NeoBuzz.Editor.Avalonia\**\*.cs" Link="ManifestEditor\EditorAvalonia\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Machines\NeoBuzz.ManifestEditor\**\*.cs" Link="ManifestEditor\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The Neo machines in Gear, with their editors on Avalonia (studio-mvp.md S1), and the Link helper. -->
  <PropertyGroup>
    <NeoGearFlavour>Studio</NeoGearFlavour>
  </PropertyGroup>
  <Import Project="..\ReBuzz.Host\AppGear.targets" />

</Project>
